; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ultimate chem battle"
run/main_scene="res://scenes/Home.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
Audio="*res://scripts/audio.gd"
Transition="*res://scripts/transition.gd"
Fx="*res://scripts/fx.gd"
UiPolish="*res://scripts/ui_polish.gd"
UiAdaptive="*res://scripts/ui_adaptive.gd"
Playtest="*res://scripts/playtest.gd"

[display]

window/size/viewport_width=780
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/aspect="expand"

[gui]

timers/tooltip_delay_sec=0.3
theme/custom="res://theme/game_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
