corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[resource]
default_font = SubResource("SystemFont_ucb_ui")
; 16 -> 18 (2026-09-01, owner: "ปรับให้ใหญ่อ่านง่าย"). Kept modest on purpose --
; the ShopPanel recipe-list collapse this file already warns about (see the
; comment near the Button styleboxes) was triggered by less growth than this
; once before. Verified visually afterward, not just left to the checker.
default_font_size = 18

Button/colors/font_color = Color(0.933, 0.91, 0.949, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(0.949, 0.776, 0.427, 1)
Button/colors/font_focus_color = Color(1, 1, 1, 1)
Button/colors/font_disabled_color = Color(0.62, 0.58, 0.66, 1)
Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_focus")

Label/colors/font_color = Color(0.933, 0.91, 0.949, 1)
Label/colors/font_outline_color = Color(0.025, 0.018, 0.04, 0.92)
Label/constants/outline_size = 1
Button/constants/outline_size = 2
Button/colors/font_outline_color = Color(0.025, 0.018, 0.04, 0.92)
TooltipLabel/font_sizes/font_size = 18

Panel/styles/panel = SubResource("panel_surface")
PanelContainer/styles/panel = SubResource("panel_container")

ProgressBar/styles/background = SubResource("progress_bg")
ProgressBar/styles/fill = SubResource("progress_fill")

HSeparator/styles/separator = SubResource("separator_line")
HSeparator/constants/separation = 8

ScrollContainer/styles/panel = SubResource("scroll_empty")

TooltipPanel/styles/panel = SubResource("tooltip_panel")
TooltipLabel/colors/font_color = Color(0.953, 0.918, 0.831, 1)
