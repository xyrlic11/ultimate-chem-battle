corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

; --- Surfaces ------------------------------------------------------------
; `Panel` is the Board in Main.tscn and the StatusBar; `PanelContainer` is the
; MonsterPanel / ResultPanel in Battle.tscn and the fighter chips built in
; battle.gd. Slightly lighter than the scene background so the play area has a
; visible edge instead of bleeding into the backdrop.

[sub_resource type="StyleBoxFlat" id="panel_surface"]
bg_color = Color(0.09, 0.075, 0.13, 0.99)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.431, 0.318, 0.161, 0.9)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
shadow_color = Color(0.02, 0.012, 0.03, 0.55)
shadow_size = 5

[sub_resource type="StyleBoxFlat" id="panel_container"]
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0
bg_color = Color(0.11, 0.09, 0.145, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.722, 0.541, 0.271, 0.72)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
shadow_color = Color(0.02, 0.012, 0.03, 0.6)
shadow_size = 7

; --- HP bars -------------------------------------------------------------
; Used for both the monster bar and every fighter chip's bar. Red fill is the
; genre convention and needs no legend; the dark trough keeps a nearly-dead
; bar still legible as a bar.

[sub_resource type="StyleBoxFlat" id="progress_bg"]
bg_color = Color(0.043, 0.035, 0.063, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.431, 0.318, 0.161, 0.8)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

; Fill radius is deliberately SMALLER than the trough's. At radius 6 a fighter
; down to a few HP drew as a red circle rather than a thin sliver -- the rounding
; ate the whole remaining width, so "nearly dead" and "slightly hurt" looked
; alike. 3 keeps the soft edge while still reading as a bar at low values.
[sub_resource type="StyleBoxFlat" id="progress_fill"]
bg_color = Color(0.82, 0.28, 0.32, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

