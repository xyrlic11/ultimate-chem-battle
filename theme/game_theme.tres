[gd_resource type="Theme" load_steps=17 format=3]

[ext_resource type="FontFile" path="res://theme/Mali-Regular.ttf" id="font_mali"]
[ext_resource type="FontFile" path="res://theme/NotoSans-Regular.ttf" id="font_latin"]
[ext_resource type="FontFile" path="res://theme/NotoSansThai-Regular.ttf" id="font_thai"]
[ext_resource type="FontFile" path="res://theme/NotoEmoji-UCBSubset.ttf" id="font_emoji"]

; Project-wide default theme.
;
; ── PART 1: FONT ──────────────────────────────────────────────────────────
;
; WHY THIS EXISTS: before this file, the project bundled no font at all. Thai
; text and emoji rendered purely by accident, via Godot's automatic system-font
; fallback picking up whatever Windows happened to have installed. That works on
; this machine and silently breaks anywhere else.
;
; This pins the choice explicitly instead. font_names is tried in order; the
; first name present on the machine wins. allow_system_fallback then covers any
; remaining glyphs (notably emoji -> Segoe UI Emoji on Windows).
;
; Leelawadee UI is first because it covers BOTH Latin and Thai cleanly, so the
; UI does not visibly switch typefaces mid-sentence in mixed strings like
; "H2O (น้ำ)". Noto Sans Thai / Sarabun are the cross-platform open equivalents.
;
; STILL TO DO FOR WEB / ANDROID EXPORT: a SystemFont resolves against fonts
; installed on the player's device, and a browser gives Godot no such list --
; a Web export will still show tofu boxes for Thai. To fix that you must bundle
; an actual font file. See theme/README.md for the exact steps.
;
; ── PART 2: STYLEBOXES ────────────────────────────────────────────────────
;
; WHY: this theme used to set ONLY the font, so every Button, Panel and
; ProgressBar in the game still drew with Godot's stock grey default theme,
; while atom.gd / molecule.gd / battle.gd each hand-built their own
; StyleBoxFlat. Result: the Shop screen and the Battle screen did not read as
; the same game. These styleboxes give the container chrome one shared look;
; the per-element colours (KIND_COLOR etc.) deliberately stay in recipes.gd
; because they carry gameplay meaning, not decoration.
;
; ⚠ VERTICAL PADDING IS DELIBERATELY CONSERVATIVE. `ShopPanel` in Main.tscn is
; vertically tight -- PROGRESS.md documents a real bug where extra fixed height
; there collapsed the recipe list to zero. Button content_margin_top/bottom is
; kept at 5px, close to Godot's own default, so this pass does not grow buttons
; enough to re-trigger it. If you raise these, re-check the Shop screen in a
; real window; headless tests cannot see it. Same warning as default_font_size.

; A SystemFont resolved against whatever the machine had installed, which is
; nothing at all in a browser: browsers expose no font list, so a web build drew
; every character as a blank box. Bundled files are the only thing that renders
; everywhere.
;
; Mali is the BASE font as of 2026-09-01 (owner: "ปรับฟอนต์ไทยให้มันสวยๆสนุกๆ" --
; a friendlier, rounder look than Noto Sans's plain default, still OFL and still
; full Thai+Latin+digit coverage in the one file, per google/fonts' ofl/mali).
; Everything Mali itself can draw -- which per check_glyphs.gd is everything
; this project actually uses in Thai and Latin -- now renders in Mali; the three
; below only ever fire for something Mali is missing:
;
;   NotoSans       Latin/digit/punctuation safety net if Mali lacks one
;   NotoSansThai   Thai safety net if Mali lacks a character
;   NotoEmoji      a 12KB subset cut to the emoji this game actually uses.
;                  Monochrome on purpose: it inherits Label font_color, so the
;                  coin glyph comes out gold wherever gold is already set.
;
; Order is base-then-fallbacks and Godot walks it in order. Run
; tools/check_glyphs.gd after touching any user-facing string OR after
; changing this list: it fails on any character no bundled font can draw,
; which is the only way to find out before a player does.
[sub_resource type="FontVariation" id="SystemFont_ucb_ui"]
base_font = ExtResource("font_mali")
variation_embolden = 0.65
fallbacks = Array[Font]([ExtResource("font_latin"), ExtResource("font_thai"), ExtResource("font_emoji")])

; --- Buttons -------------------------------------------------------------
; Raised surface against the near-black background, so a button reads as
; pressable without needing a hover to discover it.

[sub_resource type="StyleBoxFlat" id="btn_normal"]
content_margin_left = 10.0
content_margin_top = 5.0
content_margin_right = 10.0
content_margin_bottom = 5.0
bg_color = Color(0.13, 0.105, 0.173, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.431, 0.318, 0.161, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

