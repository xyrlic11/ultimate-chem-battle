[sub_resource type="StyleBoxLine" id="separator_line"]
color = Color(0.431, 0.318, 0.161, 0.8)
thickness = 1

[sub_resource type="StyleBoxEmpty" id="scroll_empty"]

[sub_resource type="StyleBoxFlat" id="tooltip_panel"]
