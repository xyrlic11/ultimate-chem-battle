; LEFT versus RIGHT, facing each other.
;
; This was a single vertical stack for a long time: wave label, type legend,
; trait bar, monster panel, front row, back row, action bar, log -- eight bands
; down the screen. A player watching it described what they saw as "one grey box
; in the top-left corner and a health bar the width of the screen", with the
; right 60% empty and the log eating the bottom third. Nothing on it said who
; was fighting whom.
;
; Stacking also spent the vertical budget on headings. Folding the wave label
; and the type legend onto one line and dropping the separate monster panel
; frees roughly 486px for the arena row, which is what lets both sides actually
; be drawn at a size worth looking at.
;
; The fighter rows keep their ScrollContainers. Seven fighters in one row is
; about 700px and the team column is narrower than that, so the overflow has to
; go somewhere -- scrolling is worse than fitting but much better than clipping.
;
; ResultPanel stays an OVERLAY on the root rather than a child of Root, for the
; same reason as before: in the layout budget a result banner inside the
; VBoxContainer stole the log's last few lines exactly when the player wants to
; read why they won. As an overlay it costs zero layout space.

[node name="Battle" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Bg" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("6")

; Fantasy arena backdrop. Sits between the flat Bg and the UI, so it paints
; over the base colour but under every panel and label.
[node name="Arena" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("4")
overlay_only = true

[node name="Margins" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 12

[node name="Root" type="VBoxContainer" parent="Margins"]
layout_mode = 2
theme_override_constants/separation = 10

; Wave and type triangle share one line. They were two full-width bands before,
; which cost 56px of height to say two short things.

[node name="TopLine" type="HBoxContainer" parent="Margins/Root"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="WaveLabel" type="Label" parent="Margins/Root/TopLine"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "ด่านที่ 1"

; Run-wide HP (2026-09-01 feedback), not a fighter's HP -- lives here in the
; fixed top strip because it has to survive the scene change back to the
; shop, unlike the fighter chips below which do not.

[node name="TraitBar" type="HBoxContainer" parent="Margins/Root"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
alignment = 1
theme_override_constants/separation = 8

; Phase C (2026-09-01): who acts next, in order. Placement (front/back, then
; left-to-right) only breaks a tie between two fighters of the same kind-speed
; -- this is what actually answers "ใครเริ่มก่อนเริ่มหลัง" from the owner's own
; request, since the monster is just another entry in the same queue rather
; than always attacking last.

[node name="TurnQueue" type="HBoxContainer" parent="Margins/Root"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
alignment = 1
theme_override_constants/separation = 6

; The arena itself. Everything above and below it is fixed height, so this row
; takes whatever is left -- which is the point of the rewrite.

[node name="Field" type="HBoxContainer" parent="Margins/Root"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 14

; The team is given more width than the monster: it holds up to seven chips
; side by side, the monster is one drawing.

[node name="TeamSide" type="VBoxContainer" parent="Margins/Root/Field"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.35
theme_override_constants/separation = 6

; The row headers state the trade-off inline. A player who never reads a manual
; still learns why they would move a compound back.

[node name="FrontHeader" type="Label" parent="Margins/Root/Field/TeamSide"]
