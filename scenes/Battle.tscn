; Phase C boss-skill indicator (2026-09-01 feedback): tells the player what
; damage type the boss's periodic heavy hit does and how strong, via
; tooltip_text, without reading the log. Populated by battle.gd's
; _spawn_monster() from Traits.boss_skill(kind); hidden for a kind with none
; (the wave-1 training dummy).

[node name="BossSkillIcon" type="Label" parent="Margins/Root/Field/MonsterSide/MonsterHPRow"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -26.0
offset_top = -22.0
offset_right = 2.0
grow_horizontal = 0
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1
text = "☣"

[node name="MonsterHPLabel" type="Label" parent="Margins/Root/Field/MonsterSide"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3
text = "HP 0/0"

; The player's half of the fight. Before this the battle was a cutscene: you
; pressed "start" and watched numbers move for thirty seconds with no decision
; left to make. Energy accrues every tick and the three buttons spend it, so
; there is always something to time.
;
; Placed directly above the log rather than as an overlay, because an overlay
; would cover the log lines that explain WHY an ability did what it did -- and
; in a teaching game that explanation is the point.

[node name="ActionBar" type="PanelContainer" parent="Margins/Root"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2

[node name="ActionRow" type="HBoxContainer" parent="Margins/Root/ActionBar"]
layout_mode = 2
theme_override_constants/separation = 10

