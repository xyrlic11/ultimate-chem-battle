[ext_resource type="Script" path="res://scripts/settings_panel.gd" id="1"]

; Reusable overlay, instanced by Home and by the in-game pause menu. The root
; fills its parent and starts hidden; settings_panel.gd drives visibility.

[node name="SettingsPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Dim" type="ColorRect" parent="."]
unique_name_in_owner = true
