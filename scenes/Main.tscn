; ตัวเร่งปฏิกิริยา (catalyst) removed 2026-09-01 -- the owner felt it "ไม่เห็น
; ทำไรได้เจ๋งๆ" (never did anything that felt cool) and asked to cut it in
; favour of Phase D's per-element abilities instead. CatalystRow/Label/
; BuyCatalystButton/CatalystHint and the whole grant-a-trait mechanic are
; gone from here, main.gd and game_state.gd. Existing saves with a
; catalyst-granted bonus trait keep it (game_state.gd's `bonus_traits` stays
; read-only) -- only the ability to grant new ones is gone.

; Bottom of the side panel, not a screen-corner overlay (2026-09-01): a fixed
; anchor here collided with CatalystRow/CatalystHint above it whenever the
; side panel's own content ran long -- invisible to headless, only caught by
; actually looking at a real window. Living in the same VBoxContainer as
; everything above it means it can never overlap that content; it still
; reads as "bottom-right of the screen" because SidePanel itself sits there.

[node name="BattleSpacer" type="Control" parent="Margins/Root/SidePanel"]
layout_mode = 2
size_flags_vertical = 3

[node name="BattleRow" type="HBoxContainer" parent="Margins/Root/SidePanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ShopButton" type="Button" parent="Margins/Root/SidePanel/BattleRow"]
