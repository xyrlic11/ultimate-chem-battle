; Three columns: team (fixed) | board (expands) | side panel (fixed), plus a
; bottom-right corner for Battle/Shop and a Shop popup. 2026-09-01 relayout --
; the owner asked for TFT-like framing: board is crafting/bench only, "team"
; is its own panel you drag fielded compounds into and out of, and the whole
; buy/gold/reroll shop moves behind a popup near Battle instead of sitting
; permanently in a column. See PROGRESS.md for the full reasoning; the short
; version is CLAUDE.md rule 5/6-style -- front/back HP+30%/ATK+25% bonuses and
; field_limit() are UNCHANGED, only what decides which row a drop means has
; moved off the board and into TeamPanel's own FrontRow/BackRow containers.
;
; EVERY variable-height list here is a ScrollContainer with
; size_flags_vertical = 3 and a stretch ratio, never a fixed height. That is
; the shape that stopped the ShopPanel recipe-list collapse bug once before --
; siblings share the leftover space proportionally instead of one grabbing a
; fixed chunk and starving the rest.

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Bg" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("5")
context = 1

[node name="Margins" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 66
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 72

